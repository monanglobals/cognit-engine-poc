# Copy to .env and adjust as needed:  cp .env.example .env
# Consumed by docker-compose.yml. Defaults are already baked into the compose
# file, so the stack comes up without a .env at all.

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cognit_engine_poc
# 5442 instead of 5432: other local stacks already use the default.
POSTGRES_PORT=5442

# Connection string for the apps (host side):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5442/cognit_engine_poc

# --- Temporal -----------------------------------------------------------
# 7333/8333 instead of 7233/8233: globals-cognit already holds those.
TEMPORAL_PORT=7333
TEMPORAL_UI_PORT=8333
TEMPORAL_DB=temporal
TEMPORAL_VISIBILITY_DB=temporal_visibility

# Pin these to keep the stack reproducible.
TEMPORAL_VERSION=1.29.3
TEMPORAL_UI_VERSION=2.53.3
TEMPORAL_ADMIN_TOOLS_VERSION=1.29.7-tctl-1.18.4-cli-1.7.2

# --- API (apps/api) -----------------------------------------------------
# Validated at boot by apps/api/src/config/env.validation.ts — a missing or
# malformed value stops the process with a readable report.
NODE_ENV=development
# 3343 instead of 3333: globals-cognit already holds that port locally.
PORT=3343
# Comma-separated list of origins allowed to reach the REST API and the /chat
# WebSocket gateway.
CORS_ORIGIN=http://localhost:3000

# Must point at the Postgres above.
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/cognit_engine_poc

# --- LLM ----------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional. Leave unset for OpenAI itself; point it at an OpenAI-compatible
# gateway (e.g. https://openrouter.ai/api/v1) to switch providers without code
# changes.
# OPENAI_BASE_URL=
